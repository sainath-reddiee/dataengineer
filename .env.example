# .env.example
# Copy this to .env and fill in your values

# Admin Auth (SHA-256 hashes of your username and password)
# Generate with: node -e "require('crypto').createHash('sha256').update('your-value').digest('hex')"
# This site is static (deployed via FTP, no server backend) — admin auth is a
# pure client-side hash comparison. These VITE_ values are bundled into the
# client JS, so treat them as a deterrent (keeps the URL out of casual reach),
# not a strong security boundary.
VITE_ADMIN_USER_HASH=your-sha256-username-hash
VITE_ADMIN_PASS_HASH=your-sha256-password-hash

# AdSense Configuration
VITE_ADSENSE_PUBLISHER_ID=ca-pub-XXXXXXXXXX
VITE_ADS_ENABLED=false
# Display Ad slot ID — get this from AdSense UI → Ads → By Ad Unit → Create Display Ad
# Once set, AdPlacement.jsx will render a real <ins> unit instead of relying on Auto Ads only.
VITE_ADSENSE_SLOT_ID=

# AdSense for pSEO pages (used by static page generator)
# Set this to enable ads on glossary/comparison pages
ADSENSE_PUBLISHER_ID=ca-pub-XXXXXXXXXX

# Google Analytics
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Giscus Comments (GitHub Discussions)
VITE_GISCUS_REPO=your-username/your-repo
VITE_GISCUS_REPO_ID=your-repo-id
VITE_GISCUS_CATEGORY=General
VITE_GISCUS_CATEGORY_ID=your-category-id

# Newsletter signups are stored only in WordPress (wp_newsletter_subscribers).
# Do not add Brevo/Buttondown/Kit keys to Vite — they would ship to every visitor.
# To list emails in /admin/weekly-digest, set the same token in both places:
#   wp-config.php: define('DEHUB_NEWSLETTER_EXPORT_TOKEN', 'long-random-string');
# VITE_NEWSLETTER_EXPORT_TOKEN=

# Web3Forms Contact & Advertise Form
# Free tier: unlimited submissions, no credit card required
# Sign up at https://web3forms.com — enter the email where you want to receive form submissions
# You'll receive an access key (UUID) via email
VITE_WEB3FORMS_KEY=your-web3forms-access-key

# Google Search Console (Optional — for real rank/impression data in admin)
# 1. Go to https://console.cloud.google.com/ → APIs & Services → Credentials
# 2. Create OAuth 2.0 Client ID (Web application type)
# 3. Add authorized origins: https://dataengineerhub.blog, http://localhost:5173
# 4. Add authorized redirect URIs:
#    - https://dataengineerhub.blog/admin/rank-dashboard
#    - http://localhost:5173/admin/rank-dashboard
# 5. Enable "Google Search Console API" in APIs & Services → Library
# See GSC_SETUP.md for full instructions
VITE_GSC_CLIENT_ID=your-client-id.apps.googleusercontent.com

# WordPress Application Password: NEVER put it in a VITE_* variable.
# Everything prefixed VITE_ is compiled into the public JavaScript that every
# visitor downloads (a WordPress password once leaked this way). The admin
# Contributor Manager asks for the application password at runtime and keeps
# it in sessionStorage only. scripts/verifyNoBundledSecrets.js fails the build
# if a secret-looking VITE_ variable appears.
