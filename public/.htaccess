# ==============================================================================
# DATAENGINEERHUB.BLOG - SEO-OPTIMIZED .HTACCESS CONFIGURATION
# Fixed: Redirect errors, indexing issues, and character encoding
# ==============================================================================

# ==============================================================================
# A) REACT ROUTER & SPA CONFIGURATION WITH STATIC ARTICLE SUPPORT
# ==============================================================================

<IfModule mod_rewrite.c>
    # Turn on the rewriting engine
    RewriteEngine On
    
    # Set the base for all relative paths
    RewriteBase /
    
    # ========================================================================
    # CRITICAL FIX: Proper redirect order to prevent loops
    # ========================================================================
    
    # Step 1: Redirect www to non-www FIRST (both HTTP and HTTPS)
    RewriteCond %{HTTP_HOST} ^www\.dataengineerhub\.blog [NC]
    RewriteRule ^(.*)$ https://dataengineerhub.blog/$1 [L,R=301]
    
    # Step 2: Force HTTPS (only if not already HTTPS and not www)
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} !^www\. [NC]
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    # ========================================================================
    # ADSENSE: thin tag archives (1-2 posts) are doorway pages. Send them to
    # the article library so crawlers never score a one-card listing as a
    # unique content URL. Substantial tags (3+ posts) still have their own HTML.
    # ========================================================================
    RewriteRule ^tag/(ai-coding|anthropic|ci-cd|claude-code|claude-md|copilot|delta-lake|developer-tools|duckdb|fusion|gcp|migration|ml|openflow|osi|perfect|prompt-engineering|rag|security|synapse|databricks|llm|optimization|i)/?$ /articles [R=301,L]

    # Contributor profile URLs are SPA-only (no unique static HTML). Direct
    # crawler hits 404'd; serving index.html would look like a duplicate
    # homepage. Send them to the contributors directory instead.
    RewriteRule ^contributors/[^/]+/?$ /contributors [R=301,L]

    # ========================================================================
    # KEYWORD CANNIBALIZATION: 301 redirects for consolidated articles
    # ========================================================================
    
    RewriteRule ^articles/snowflake-query-optimization-2025/?$ /articles/snowflake-query-optimization-guide-2026 [R=301,L]
    RewriteRule ^articles/building-snowflake-agents-in-10-minutes/?$ /articles/build-snowflake-cortex-ai-agent-guide [R=301,L]
    RewriteRule ^articles/build-a-snowflake-agent-in-10-minutes/?$ /articles/build-snowflake-cortex-ai-agent-guide [R=301,L]
    RewriteRule ^articles/snowflake-unique-aggregation-hidden-functions/?$ /articles/snowflake-unique-aggregations-hidden-functions [R=301,L]
    RewriteRule ^articles/snowflake-options-automate-query-optimization-guide/?$ /articles/snowflake-optima-automatic-query-optimization-guide [R=301,L]
    RewriteRule ^articles/build-a-simple-rag-application-in-snowflake-using-streamlit-and-snowflake-cortex/?$ /articles/build-rag-snowflake-cortex-search-guide [R=301,L]
    RewriteRule ^articles/build-rag-snowflake-documentation/?$ /articles/build-rag-snowflake-cortex-search-guide [R=301,L]
    RewriteRule ^articles/snowflake-openflow-tutorial/?$ /articles/snowflake-openflow-ai-data-ingestion-guide [R=301,L]
    RewriteRule ^articles/snowflake-performance/?$ /articles/snowflake-query-optimization-guide-2026 [R=301,L]
    RewriteRule ^articles/snowflake-performance-tuning-techniques/?$ /articles/snowflake-query-optimization-guide-2026 [R=301,L]
    RewriteRule ^articles/loading-data-from-s3-to-snowflake/?$ /articles/load-data-into-snowflake [R=301,L]

    # Cookie policy lives in the Privacy Policy cookies section — do not 404.
    RewriteRule ^cookie-policy/?$ /privacy-policy [R=301,L]

    # Short playground URL (matches the common /playground habit).
    RewriteRule ^playground/?$ /tools/sql-playground [R=301,L]
    
    # ========================================================================
    # CRITICAL FIX: Handle trailing slashes consistently (SEO!)
    # DirectorySlash is Off below so Apache will not 301 /news -> /news/.
    # Strip the slash from every URL except root so sitemap/canonicals match.
    # ========================================================================
    
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^(.+)/$ /$1 [R=301,L]
    
    # ========================================================================
    # NEW FIX: Handle /articles route - serve pre-rendered listing if exists
    # ========================================================================
    
    # If someone visits /articles or /articles/ (the listing page)
    # serve pre-rendered HTML if it exists. END (not L) is required: LiteSpeed
    # restarts the rewrite engine after an internal [L] rewrite, and the
    # per-slug 404 below would then treat "index.html" as a missing article.
    # That is what 404'd the live listing after the 2026-09-06 force-rebuild
    # even though FTP had uploaded articles/index.html.
    RewriteCond %{DOCUMENT_ROOT}/articles/index.html -f
    RewriteRule ^articles/?$ /articles/index.html [END]
    
    # ========================================================================
    # CRITICAL FIX: Serve static HTML for articles if it exists
    # ========================================================================
    
    # For requests to /articles/slug (without trailing slash)
    # Check if /articles/slug/index.html exists. Skip the listing file itself:
    # after an internal rewrite, REQUEST_URI becomes /articles/index.html and
    # ([^/]+) would otherwise capture "index.html" as a slug.
    RewriteCond %{REQUEST_URI} ^/articles/([^/]+)/?$
    RewriteCond %1 !^index\.html$
    RewriteCond %{DOCUMENT_ROOT}/articles/%1/index.html -f
    RewriteRule ^articles/([^/]+)/?$ /articles/$1/index.html [END]

    # A missing article must be a real 404. Serving /index.html here exposes
    # homepage title/canonical/body on an article URL, which is a crawler-visible
    # duplicate. The WordPress publish hook builds SSG before the URL is public.
    RewriteCond %{REQUEST_URI} ^/articles/([^/]+)/?$
    RewriteCond %1 !^index\.html$
    RewriteCond %{DOCUMENT_ROOT}/articles/%1/index.html !-f
    RewriteRule ^articles/([^/]+)/?$ - [R=404,L]
    
    # ========================================================================
    # ESSENTIAL PAGES: Serve pre-rendered static HTML for SEO
    # (About, Contact, Privacy Policy, Terms of Service, Disclaimer)
    # ========================================================================
    
    # For requests to /about, /contact, /privacy-policy, /terms-of-service, /disclaimer
    # Check if /{page}/index.html exists and serve it directly
    RewriteCond %{DOCUMENT_ROOT}/about/index.html -f
    RewriteRule ^about/?$ /about/index.html [END]
    
    RewriteCond %{DOCUMENT_ROOT}/contact/index.html -f
    RewriteRule ^contact/?$ /contact/index.html [END]
    
    RewriteCond %{DOCUMENT_ROOT}/privacy-policy/index.html -f
    RewriteRule ^privacy-policy/?$ /privacy-policy/index.html [END]
    
    RewriteCond %{DOCUMENT_ROOT}/terms-of-service/index.html -f
    RewriteRule ^terms-of-service/?$ /terms-of-service/index.html [END]
    
    RewriteCond %{DOCUMENT_ROOT}/disclaimer/index.html -f
    RewriteRule ^disclaimer/?$ /disclaimer/index.html [END]
    
    # ========================================================================
    # CATEGORY PAGES: Serve pre-rendered static HTML for category pages
    # ========================================================================
    
    # For requests to /category/slug - serve pre-rendered HTML if it exists
    RewriteCond %{REQUEST_URI} ^/category/([^/]+)/?$
    RewriteCond %{DOCUMENT_ROOT}/category/%1/index.html -f
    RewriteRule ^category/([^/]+)/?$ /category/$1/index.html [L]
    
    # For requests to /tag/slug - serve pre-rendered HTML if it exists
    RewriteCond %{REQUEST_URI} ^/tag/([^/]+)/?$
    RewriteCond %{DOCUMENT_ROOT}/tag/%1/index.html -f
    RewriteRule ^tag/([^/]+)/?$ /tag/$1/index.html [L]
    
    # For requests to /glossary (hub listing page) - serve pre-rendered HTML
    RewriteCond %{DOCUMENT_ROOT}/glossary/index.html -f
    RewriteRule ^glossary/?$ /glossary/index.html [END]
    
    # For requests to /glossary/slug - serve pre-rendered HTML if it exists
    RewriteCond %{REQUEST_URI} ^/glossary/([^/]+)/?$
    RewriteCond %{DOCUMENT_ROOT}/glossary/%1/index.html -f
    RewriteRule ^glossary/([^/]+)/?$ /glossary/$1/index.html [L]
    
    # For requests to /compare (hub listing page) - serve pre-rendered HTML
    RewriteCond %{DOCUMENT_ROOT}/compare/index.html -f
    RewriteRule ^compare/?$ /compare/index.html [END]
    
    # For requests to /compare/slug - serve pre-rendered HTML if it exists
    RewriteCond %{REQUEST_URI} ^/compare/([^/]+)/?$
    RewriteCond %{DOCUMENT_ROOT}/compare/%1/index.html -f
    RewriteRule ^compare/([^/]+)/?$ /compare/$1/index.html [L]
    
    # For requests to /cheatsheets (hub listing page) - serve pre-rendered HTML
    RewriteCond %{DOCUMENT_ROOT}/cheatsheets/index.html -f
    RewriteRule ^cheatsheets/?$ /cheatsheets/index.html [END]
    
    # For requests to /cheatsheets/slug - serve pre-rendered HTML if it exists
    RewriteCond %{REQUEST_URI} ^/cheatsheets/([^/]+)/?$
    RewriteCond %{DOCUMENT_ROOT}/cheatsheets/%1/index.html -f
    RewriteRule ^cheatsheets/([^/]+)/?$ /cheatsheets/$1/index.html [L]
    
    # ========================================================================
    # IMPORTANT: Exclude common files from rewrite rules
    # ========================================================================
    
    # Don't rewrite robots.txt, sitemap.xml, favicon.ico, or agent-discovery files
    RewriteRule ^(robots\.txt|sitemap\.xml|sitemap-index\.xml|favicon\.ico|auth\.md|openapi\.json|llms\.txt|llms-full\.txt|llm-sitemap\.json|rss\.xml|index\.md)$ - [L]

    # RFC 8615 / RFC 9727: serve /.well-known/* from /well-known/* so FTP
    # deploy does not have to upload a leading-dot directory on Hostinger.
    RewriteRule ^\.well-known/(.+)$ /well-known/$1 [L]

    # Homepage Markdown negotiation. Browsers and AdsBot send text/html and
    # keep the React/SSG HTML. Agents that send Accept: text/markdown get index.md.
    RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
    RewriteRule ^$ /index.md [L]
    
    # ========================================================================
    # IMPORTANT: Allow real files and directories to be served directly
    # ========================================================================
    
    # If the requested path IS a real file, serve it
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Serve /path/index.html internally BEFORE treating /path as a directory.
    # SSG writes news/index.html, tools/index.html, etc. Apache would otherwise
    # DirectorySlash-301 /news -> /news/, fighting sitemap and canonicals.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
    RewriteRule ^(.+?)/?$ /$1/index.html [L]
    
    # If the requested path IS a real directory with no index.html, stop here
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    
    # ========================================================================
    # SPA fallback ONLY for private app shells. Unknown public URLs MUST 404.
    # Serving index.html here previously made /news, /practice, /advertise,
    # /contributors (and any other missing route) look like duplicate
    # homepages to AdSense — a repeated "low value content" rejection.
    # ========================================================================
    # /announcements and /advertise/checkout are React-rendered and noindexed
    # (X-Robots-Tag above).
    RewriteCond %{REQUEST_URI} ^/(admin|debug|sponsors/dashboard|announcements|advertise/checkout)(/|$) [NC]
    RewriteRule ^ /index.html [L]

</IfModule>

<IfModule mod_dir.c>
    DirectoryIndex index.html
    # Off: do not 301 /news -> /news/. Canonicals and the sitemap omit the slash.
    DirectorySlash Off
</IfModule>

# AdSense review safety net. The static generator already emits
# <meta name="robots" content="noindex, follow"> on these held-out page types,
# but Hostinger can keep old HTML in its full-page cache for 24 hours after an
# FTP replacement. Send the directive at HTTP level as well, and prevent new
# cached copies from delaying a review-mode change.
# Plain SetEnvIf, not SetEnvIfExpr: Hostinger's LiteSpeed ignores
# SetEnvIfExpr, so the header never fired live. DEH_PRIVATE_APP below uses the
# same SetEnvIf form and is confirmed working in production.
# Lists must match src/data/adsenseQualityGate.js (verifyAdsenseQualityGate checks).
<IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/(glossary|compare|tag|tags|cheatsheets/category|category|interview-prep|practice|roadmaps|advertise|contribute|contributors|news|newsletter|reading-list)(/|$)" ADSENSE_REVIEW_PATH
    # Sponsored announcements (press releases) are always noindex, not only during review.
    SetEnvIf Request_URI "^/announcements(/|$)" ADSENSE_REVIEW_PATH
    SetEnvIf Request_URI "^/cheatsheets/(?!(snowflake-sql|sql-window-functions|dbt-commands|airflow-essentials|snowflake-best-practices|databricks|python-for-data-engineers|data-modeling)(/|$))[^/]+" ADSENSE_REVIEW_PATH
    SetEnvIf Request_URI "^/tools/(?!(snowflake-cost-calculator|cloud-data-warehouse-cost-comparison|sql-playground|databricks-cost-calculator|bigquery-cost-calculator)(/|$))[^/]+" ADSENSE_REVIEW_PATH
</IfModule>
<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, follow" env=ADSENSE_REVIEW_PATH
    Header always set Cache-Control "no-store, max-age=0, must-revalidate" env=ADSENSE_REVIEW_PATH
</IfModule>

# ==============================================================================
# B) BROWSER CACHING - EXTENDED (PERFORMANCE BOOST)
# ==============================================================================

<IfModule mod_expires.c>
    ExpiresActive On
    
    # Images - cache for 1 year (immutable assets)
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/vnd.microsoft.icon "access plus 1 year"
    
    # CSS and JavaScript - cache for 1 year (versioned assets)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"
    
    # Fonts - cache for 1 year
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
    ExpiresByType application/x-font-opentype "access plus 1 year"
    ExpiresByType application/x-font-truetype "access plus 1 year"
    ExpiresByType application/x-font-ttf "access plus 1 year"
    
    # Media files - cache for 1 year
    ExpiresByType video/mp4 "access plus 1 year"
    ExpiresByType video/webm "access plus 1 year"
    ExpiresByType audio/mpeg "access plus 1 year"
    ExpiresByType audio/ogg "access plus 1 year"
    
    # HTML - SHORT cache for articles (1 hour so Googlebot gets fresh content)
    ExpiresByType text/html "access plus 1 hour"
    
    # Data files - cache for 1 hour
    ExpiresByType application/json "access plus 1 hour"
    ExpiresByType application/xml "access plus 1 day"
    ExpiresByType text/xml "access plus 1 day"
    ExpiresByType text/plain "access plus 1 day"
    
    # Manifest and sitemap
    ExpiresByType application/manifest+json "access plus 1 week"
    
    # WebAssembly — SQL playground / format converter engine
    ExpiresByType application/wasm "access plus 1 year"

    # Default - cache for 1 day
    ExpiresDefault "access plus 1 day"

</IfModule>

# Cache-Control Headers (more modern than Expires)
<IfModule mod_headers.c>
    # Static assets with hash/version - immutable for 1 year
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|css|js|woff|woff2|ttf|otf|eot|wasm)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    
    # HTML files in articles/ - shorter cache so crawlers get updates
    <FilesMatch "^articles/.*\.html$">
        Header set Cache-Control "public, max-age=3600, must-revalidate"
    </FilesMatch>
    
    # Other HTML files - short cache with revalidation
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "public, max-age=3600, must-revalidate"
    </FilesMatch>
    
    # JSON, XML, TXT - moderate cache
    <FilesMatch "\.(json|xml|txt)$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>
    
    # Remove ETags (they cause caching issues with multiple servers)
    Header unset ETag
    FileETag None

</IfModule>

# ==============================================================================
# C) GZIP COMPRESSION - EXTENDED (PERFORMANCE)
# ==============================================================================

<IfModule mod_deflate.c>
    # Compress HTML, CSS, JavaScript
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
    
    # Compress JavaScript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    
    # Compress XML
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/atom+xml
    
    # Compress fonts
    AddOutputFilterByType DEFLATE font/opentype
    AddOutputFilterByType DEFLATE font/otf
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE application/font-woff
    AddOutputFilterByType DEFLATE application/font-woff2
    AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
    AddOutputFilterByType DEFLATE application/x-font-opentype
    AddOutputFilterByType DEFLATE application/x-font-truetype
    AddOutputFilterByType DEFLATE application/x-font-ttf
    
    # Compress SVG
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE image/x-icon
    
</IfModule>

# ==============================================================================
# D) SECURITY HEADERS - ENHANCED
# ==============================================================================

<IfModule mod_headers.c>
    # CORS - Allow your API subdomain
    Header always set Access-Control-Allow-Origin "https://app.dataengineerhub.blog"
    Header always set Access-Control-Allow-Methods "GET, POST, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type"
    
    # Prevent MIME-sniffing
    Header set X-Content-Type-Options "nosniff"
    
    # Prevent clickjacking
    Header set X-Frame-Options "DENY"
    
    # XSS Protection (legacy, but still good)
    Header set X-XSS-Protection "1; mode=block"
    
    # Referrer Policy - balance between privacy and analytics
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Permissions Policy (formerly Feature-Policy)
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    
    # HSTS - Force HTTPS for 1 year, include subdomains
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # Private app shells must never look like indexable homepage copies.
    SetEnvIf Request_URI "^/(admin|debug|sponsors/dashboard)" DEH_PRIVATE_APP
    Header set X-Robots-Tag "noindex, nofollow" env=DEH_PRIVATE_APP

    # RFC 8288 + RFC 9727 §3: homepage Link headers for agent discovery.
    # Also emit them on the catalog itself so HEAD /.well-known/api-catalog
    # includes the api-catalog relation.
    SetEnvIf Request_URI "^/$" DEH_AGENT_LINKS
    SetEnvIf Request_URI "^/index\.html$" DEH_AGENT_LINKS
    SetEnvIf Request_URI "^/\.well-known/api-catalog" DEH_AGENT_LINKS
    SetEnvIf Request_URI "^/well-known/api-catalog" DEH_AGENT_LINKS
    # Unquoted rel/type tokens: LiteSpeed emits literal backslashes if we write rel=\"...\".
    # RFC 8288 allows unquoted registered relation types.
    Header always set Link "</.well-known/api-catalog>; rel=api-catalog, </openapi.json>; rel=service-desc; type=application/json, </llms.txt>; rel=service-doc; type=text/plain, </llm-sitemap.json>; rel=describedby; type=application/json" env=DEH_AGENT_LINKS
    Header always set Content-Signal "search=yes, ai-input=yes, ai-train=yes"
    Header append Vary Accept env=DEH_AGENT_LINKS

</IfModule>

# ==============================================================================
# E) PERFORMANCE OPTIMIZATIONS
# ==============================================================================

# Disable server signature (security + performance)
ServerSignature Off

# Prevent directory browsing
Options -Indexes

# Prevent access to hidden files (like .git, .env) - FIXED QUOTES
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Prevent access to backup files - FIXED QUOTES
<FilesMatch "\.(bak|config|sql|fla|psd|ini|log|sh|inc|swp|dist)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# ==============================================================================
# F) CUSTOM ERROR PAGES - CRITICAL SEO FIX
# ==============================================================================

# IMPORTANT: Don't redirect ALL errors to index.html!
# This makes Google think error pages are successful pages

# Create proper 404 page that returns 404 status
ErrorDocument 404 /404.html

# For other errors, you can create dedicated error pages
# or use server defaults (better for SEO than redirecting to index.html)
# ErrorDocument 500 /500.html

# ==============================================================================
# G) ADDITIONAL PERFORMANCE TWEAKS
# ==============================================================================

# Enable Keep-Alive (faster for multiple requests)
<IfModule mod_headers.c>
    Header set Connection keep-alive
</IfModule>

# Limit request size (prevent DoS)
LimitRequestBody 10485760

# Set default character set
AddDefaultCharset UTF-8

# ==============================================================================
# H) FILE-SPECIFIC OPTIMIZATIONS - FIXED QUOTES
# ==============================================================================

# Force download for certain file types
<FilesMatch "\.(pdf|doc|docx|xls|xlsx)$">
    Header set Content-Disposition "attachment"
</FilesMatch>

# Proper MIME types for web fonts
<IfModule mod_mime.c>
    AddType font/woff2 .woff2
    AddType font/woff .woff
    AddType font/ttf .ttf
    AddType font/otf .otf
    AddType application/vnd.ms-fontobject .eot
    
    # Additional MIME types for better compatibility
    AddType application/json .json
    AddType text/markdown .md
    AddType image/svg+xml .svg
    AddType image/webp .webp
    AddType application/wasm .wasm
</IfModule>

# Agent-discovery documents (RFC 9727 catalog has no file extension)
<IfModule mod_headers.c>
    <Files "api-catalog">
        Header set Content-Type "application/linkset+json; profile=\"https://www.rfc-editor.org/info/rfc9727\""
        Header set Cache-Control "public, max-age=86400"
        Header always set Access-Control-Allow-Origin "*"
    </Files>
    <Files "auth.md">
        Header set Content-Type "text/markdown; charset=utf-8"
        Header set Cache-Control "public, max-age=86400"
        Header always set Access-Control-Allow-Origin "*"
    </Files>
    <Files "SKILL.md">
        Header set Content-Type "text/markdown; charset=utf-8"
        Header set Cache-Control "public, max-age=86400"
        Header always set Access-Control-Allow-Origin "*"
    </Files>
    <Files "index.md">
        Header set Content-Type "text/markdown; charset=utf-8"
        Header set Cache-Control "public, max-age=3600, must-revalidate"
        Header set x-markdown-tokens "412"
    </Files>
    <Files "index.json">
        Header always set Access-Control-Allow-Origin "*"
    </Files>
    <Files "ai-catalog.json">
        Header always set Access-Control-Allow-Origin "*"
    </Files>
</IfModule>

# ==============================================================================
# I) SEO-SPECIFIC OPTIMIZATIONS
# ==============================================================================

# Ensure XML sitemaps are served with correct MIME type
<FilesMatch "\.(xml)$">
    Header set Content-Type "application/xml; charset=utf-8"
</FilesMatch>

# Ensure robots.txt is served correctly
<FilesMatch "^robots\.txt$">
    Header set Content-Type "text/plain; charset=utf-8"
</FilesMatch>

# auth.md is Markdown for Auth.md agent discovery
<FilesMatch "^auth\.md$">
    Header set Content-Type "text/markdown; charset=utf-8"
</FilesMatch>

# ==============================================================================
# J) CACHE-CONTROL — Prevent bots from seeing stale SSG snapshots
# ==============================================================================
# HTML pages: short cache so crawlers re-fetch fresh content after each deploy.
# stale-while-revalidate lets the CDN serve the old page instantly while
# fetching the new one in the background — zero downtime, zero staleness.
<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header set Cache-Control "public, max-age=3600, stale-while-revalidate=86400"
    </FilesMatch>
</IfModule>

# Hashed JS/CSS/font assets: immutable 1-year cache (filenames change on rebuild)
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# Images: 7-day cache (content rarely changes, but not immutable)
<IfModule mod_headers.c>
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg|ico)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

# ==============================================================================
# END OF CONFIGURATION
# ==============================================================================
