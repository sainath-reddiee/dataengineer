# Cloudflare Pages headers. Hostinger/LiteSpeed ignores this file and keeps
# using .htaccess. Do not add a catch-all that would index preview URLs.
#
# More specific rules override earlier ones for the same header name.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Signal: search=yes, ai-input=yes, ai-train=yes
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/*.wasm
  Content-Type: application/wasm
  Cache-Control: public, max-age=31536000, immutable

https://:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store, max-age=0, must-revalidate

/
  Link: </.well-known/api-catalog>; rel=api-catalog, </openapi.json>; rel=service-desc; type=application/json, </llms.txt>; rel=service-doc; type=text/plain, </llm-sitemap.json>; rel=describedby; type=application/json

